{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CoC-MS/security-template/schemas/generated-manifest.schema.json",
  "title": "Generated publication manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "publicationVersion", "generatedAt", "publisher", "files", "removals"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "publicationVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "publisher": { "type": "string", "minLength": 2, "maxLength": 100 },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "byteLength", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^(catalog\\.json|templates/(intune|defender|purview|entra)/[A-Za-z0-9._/-]+)$" },
          "byteLength": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "removals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "priorVersion", "owner", "reason", "effectiveDate"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "priorVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
          "owner": { "type": "string", "minLength": 2, "maxLength": 100 },
          "reason": { "type": "string", "minLength": 10 },
          "effectiveDate": { "type": "string", "format": "date" },
          "replacementId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        }
      }
    }
  }
}
