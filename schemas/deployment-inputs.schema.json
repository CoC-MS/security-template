{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CoC-MS/security-template/schemas/deployment-inputs.schema.json",
  "title": "Typed deployment inputs",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "inputs"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "required", "description", "sensitive"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
          "type": { "enum": ["string", "integer", "number", "boolean", "array", "object"] },
          "required": { "type": "boolean" },
          "description": { "type": "string", "minLength": 5 },
          "sensitive": { "type": "boolean" },
          "default": {},
          "allowedValues": { "type": "array", "minItems": 1 },
          "pattern": { "type": "string" },
          "minimum": { "type": "number" },
          "maximum": { "type": "number" }
        },
        "allOf": [
          {
            "if": { "properties": { "sensitive": { "const": true } }, "required": ["sensitive"] },
            "then": { "not": { "required": ["default"] } }
          }
        ]
      }
    }
  }
}
